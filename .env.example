TP_TOKEN=
TP_BASE_URL=
TP_API_VERSION=v1

# Con be found with get_logged_in_user tool
TP_OWNER_ID=

# Con be found with 'get_projects' tool
TP_PROJECT_ID=

# Con be found with 'get_teams' tool
TP_TEAM_ID=

# hardcoded values
# Can be found with 'get_processes' tool
TP_PROCESS_ID=
TP_USER_STORY_WORKFLOW_ID=
TP_BUG_WORKFLOW_ID=

# --- Hosted Streamable HTTP mode only (src/http.ts / `npm run start:http`) ---
# Not used by the stdio server (src/index.ts).

# Shared secret gating access to the hosted server, checked against every
# request's "Authorization: Bearer <key>" header. Generate with e.g.
# `openssl rand -hex 32`. Distinct from TP_TOKEN above — this is not a
# Targetprocess credential, it just admits traffic to the hosted endpoint.
# The server refuses to start without it.
HOSTING_API_KEY=

# Optional — default 3000
HTTP_PORT=

# Optional — default 127.0.0.1. Binding to 127.0.0.1/localhost/::1 enables
# automatic DNS-rebinding protection; set HTTP_ALLOWED_HOSTS if binding to
# 0.0.0.0 behind a reverse proxy.
HTTP_HOST=

# Optional, comma-separated (e.g. "mcp.example.com,localhost"). Required if
# HTTP_HOST is set to 0.0.0.0/:: and you still want Host-header validation.
HTTP_ALLOWED_HOSTS=
